# Configuração da Extensão Firebase: Export Collections to BigQuery
# Instância: itens_lote
LOCATION=southamerica-east1
DATASET_LOCATION=southamerica-east1
BIGQUERY_RESOURCE_LOCATION=southamerica-east1
DATASET_ID=govtech_analytics
TABLE_ID=itens_lote
COLLECTION_PATH=itens_lote
WILD_CARD_COLUMN=false
TIME_PARTITIONING_FIELD=_PARTITIONTIME
TIME_PARTITIONING_TYPE=DAY
TIME_PARTITIONING_FIELD_TYPE=TIMESTAMP
MAX_BATCH_SIZE=300
