{
  "name": "govtech-nllc",
  "version": "2.3.0",
  "description": "Plataforma de Inteligência em Licitações Públicas (Lei nº 14.133/2021 & IN SEGES/ME nº 65/2021)",
  "scripts": {
    "typecheck": "node scripts/verify_codebase.js --typecheck",
    "lint": "node scripts/verify_codebase.js --lint",
    "test:unit": "node --test tests/in65_math_engine.test.js src/tests/unit/pncpLinksAndQrCode.test.ts src/tests/unit/documentBranding.test.ts src/tests/unit/in65DomainAndStatistics.test.ts",
    "build": "node scripts/verify_codebase.js --build",
    "test": "npm run test:unit",
    "test:python": "python -m unittest discover -s backend/tests",
    "test:all": "npm run test:unit && npm run test:python",
    "predeploy:hosting": "node scripts/check_ci_deploy_lock.js",
    "deploy:preview": "firebase hosting:channel:deploy",
    "deploy:prod": "firebase deploy --only hosting"
  },
  "keywords": [
    "licitacoes",
    "govtech",
    "comprasnet",
    "pncp",
    "in65-2021",
    "lei-14133"
  ],
